#!/usr/bin/env bash
# Local stand-in for branch protection: no direct commits on main.
# Work on a branch and merge it in. Override once with: git commit --no-verify
branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
if [ "$branch" = "main" ]; then
  echo "Blocked: don't commit directly on main. Create a branch: git switch -c <name>" >&2
  exit 1
fi
